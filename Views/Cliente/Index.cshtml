@model IEnumerable<Projeto_Credito_Cliente.ViewModels.ClienteIndexViewModel>;

<h1 class="Text text-center">Clientes</h1>

<input type="search" name="" id="" placeholder="Buscar cliente...">

<table class="table thead-dark">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Nome</th>
            <th scope="col">Cpf</th>
            <th scope="col">Bairro</th>
            <th scope="col">Cidade</th>
            <th scope="col">Telefone</th>
            <th scope="col">Email</th>
            <th scope="col">Ações</th>
        </tr>
    </thead>
    <tbody>

        @foreach (var item in @Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Nome</td>
                <td>@item.Cpf</td>
                <td>@item.Bairro</td>
                <td>@item.Cidade</td>
                <td>@item.Telefone</td>
                <td>@item.Email</td>
                <td>
                    <a class="btn btn-info">Visualizar</a>
                    <a class="btn btn-warning" asp-action="Edit" asp-route-Id=@item.Id>Alterar</a>
                    <a class="btn btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<a class="btn btn-secondary" asp-controller="Home" asp-action="Index">Voltar</a>